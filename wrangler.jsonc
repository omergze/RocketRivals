{
  "name": "rocketrivals",
  "main": "worker.js",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/ws", "/health"] },
  "durable_objects": { "bindings": [{ "name": "MATCHES", "class_name": "Matches" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Matches"] }]
}
